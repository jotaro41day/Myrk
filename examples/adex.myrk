fn main() -> i32 {
    population p: AdEx<f32>(size=1000, dt=0.1f32, current=500.0f32, capacitance=200.0f32, g_leak=10.0f32, v_rest=-70.0f32, v_t=-50.0f32, delta_t=2.0f32, tau_w=100.0f32, a=2.0f32, b=40.0f32, v_init=-70.0f32, w_init=0.0f32, v_reset=-58.0f32, v_threshold=20.0f32);
    var count: i32 = 0;
    for t in 0..400 { step(p); count = count + spikes(p); }
    print(count);
    print(voltage(p,0));
    print(adaptation(p,0));
    return 0;
}
